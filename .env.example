# DataMineX Local Environment Configuration Template
# Duplicate this file to .env and customize for your local setup

# HTTP Port for Express Server
PORT=3000

# PostgreSQL Database Connection String
# Example: postgresql://<username>:<password>@localhost:5432/<dbname>
# Note: If PostgreSQL is not running or DATABASE_URL is omitted, DataMineX safely falls back to In-Memory mode.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/dataminex

# JWT Secret Key for Session Authentication (Change to a strong random secret in production)
JWT_SECRET=super_secret_dataminex_token_key

# Node Environment ('development' or 'production')
NODE_ENV=development
